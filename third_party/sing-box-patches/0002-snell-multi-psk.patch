+package snell
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/option"
+	P "github.com/sagernet/sing-snell"
+	"github.com/sagernet/sing-snell/snellv4"
+	"github.com/sagernet/sing/common/auth"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type echoPSKHandler struct{ users chan int }
+
+func (h echoPSKHandler) NewConnectionEx(ctx context.Context, conn net.Conn, _, _ M.Socksaddr, onClose N.CloseHandlerFunc) {
+	user, ok := auth.UserFromContext[int](ctx)
+	if !ok {
+		user = -1
+	}
+	h.users <- user
+	go func() {
+		defer conn.Close()
+		_, err := io.Copy(conn, conn)
+		if onClose != nil {
+			onClose(err)
+		}
+	}()
+}
+
+func (h echoPSKHandler) NewPacketConnectionEx(ctx context.Context, conn N.PacketConn, _, _ M.Socksaddr, onClose N.CloseHandlerFunc) {
+	user, ok := auth.UserFromContext[int](ctx)
+	if !ok {
+		user = -1
+	}
+	h.users <- user
+	go func() {
+		defer conn.Close()
+		b := buf.NewPacket()
+		defer b.Release()
+		destination, err := conn.ReadPacket(b)
+		if err == nil {
+			response := buf.NewSize(2048)
+			response.Resize(1024, 0)
+			_, _ = response.Write(b.Bytes())
+			err = conn.WritePacket(response, destination)
+		}
+		if onClose != nil {
+			onClose(err)
+		}
+	}()
+}
+
+func pskOptions(mode string) option.SnellInboundOptions {
+	return option.SnellInboundOptions{
+		Version: 5,
+		AbstractSnellInboundOptions: option.AbstractSnellInboundOptions{
+			MultiUserPSK: true,
+			Users: []option.SnellUser{
+				{Name: "101:snell", PSK: "user-one-secret-123456"},
+				{Name: "202:snell", PSK: "user-two-secret-123456"},
+			},
+		},
+		ObfsOptions: option.SnellObfsServerOptions{ObfsMode: mode},
+	}
+}
+
+func testPSKSession(t *testing.T, s *pskService, h echoPSKHandler, psk string, mode P.ObfsMode, want int, udp bool) {
+	t.Helper()
+	server, clientConn := net.Pipe()
+	t.Cleanup(func() { server.Close(); clientConn.Close() })
+	_ = clientConn.SetDeadline(time.Now().Add(3 * time.Second))
+	errors := make(chan error, 1)
+	go func() {
+		err := s.NewConnection(context.Background(), server, M.Socksaddr{}, nil)
+		errors <- err
+		if err != nil {
+			server.Close()
+		}
+	}()
+	client, err := snellv4.NewClient(snellv4.ClientOptions{PSK: []byte(psk), ObfsMode: mode})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if udp {
+		conn, err := client.DialPacketConn(clientConn)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		if _, err := conn.WriteTo([]byte("hello-udp"), &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 53}); err != nil {
+			t.Fatal(err)
+		}
+		b := make([]byte, 9)
+		n, _, err := conn.ReadFrom(b)
+		if err != nil || string(b[:n]) != "hello-udp" {
+			t.Fatalf("UDP: %q %v", b[:n], err)
+		}
+	} else {
+		conn, err := client.DialConn(clientConn, M.ParseSocksaddr("example.com:80"))
+		if err == nil {
+			_, err = conn.Write([]byte("hello-tcp"))
+		}
+		if want < 0 {
+			if err == nil {
+				_, err = io.ReadFull(conn, make([]byte, 9))
+			}
+			if err == nil {
+				t.Fatal("unauthorized PSK accepted")
+			}
+			return
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		b := make([]byte, 9)
+		if _, err := io.ReadFull(conn, b); err != nil || string(b) != "hello-tcp" {
+			t.Fatalf("TCP: %q %v", b, err)
+		}
+	}
+	select {
+	case user := <-h.users:
+		if user != want {
+			t.Fatalf("user attribution: got %d, want %d", user, want)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("missing user attribution")
+	}
+	if len(s.handshakes) != 0 {
+		t.Fatal("authenticated session consumes handshake slot")
+	}
+}
+
+func TestMultiPSKCompatibility(t *testing.T) {
+	for _, mode := range []string{"none", "http"} {
+		t.Run(mode, func(t *testing.T) {
+			h := echoPSKHandler{users: make(chan int, 32)}
+			opts := pskOptions(mode)
+			s, err := newPSKService(opts, h)
+			if err != nil {
+				t.Fatal(err)
+			}
+			obfs, _ := P.ParseObfsMode(mode)
+			for i := 0; i < 12; i++ {
+				testPSKSession(t, s, h, opts.Users[i%2].PSK, obfs, i%2, false)
+			}
+			testPSKSession(t, s, h, opts.Users[1].PSK, obfs, 1, true)
+			testPSKSession(t, s, h, "wrong-secret-12345678", obfs, -1, false)
+			// A fresh config with user 2 removed must not authenticate their PSK.
+			opts.Users = opts.Users[:1]
+			s, err = newPSKService(opts, h)
+			if err != nil {
+				t.Fatal(err)
+			}
+			testPSKSession(t, s, h, "user-two-secret-123456", obfs, -1, false)
+		})
+	}
+}
+
+func TestMultiPSKValidation(t *testing.T) {
+	h := echoPSKHandler{users: make(chan int, 1)}
+	for _, mutate := range []func(*option.SnellInboundOptions){
+		func(o *option.SnellInboundOptions) { o.PSK = "shared-password" },
+		func(o *option.SnellInboundOptions) { o.Users[1].PSK = o.Users[0].PSK },
+		func(o *option.SnellInboundOptions) { o.Users[0].PSK = "short" },
+		func(o *option.SnellInboundOptions) { o.Users[0].UserKey = "ambiguous" },
+		func(o *option.SnellInboundOptions) { o.Users[0].Name = "" },
+		func(o *option.SnellInboundOptions) { o.Users = make([]option.SnellUser, maxPSKUsers+1) },
+	} {
+		opts := pskOptions("none")
+		mutate(&opts)
+		if _, err := newPSKService(opts, h); err == nil {
+			t.Fatal("invalid config accepted")
+		}
+	}
+	opts := pskOptions("none")
+	opts.Users = nil
+	s, err := newPSKService(opts, h)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.NewConnection(context.Background(), nil, M.Socksaddr{}, nil); err == nil {
+		t.Fatal("empty users accepted")
+	}
+}
+
+// Replay an authentic header+request. The upstream per-user salt cache must
+// still reject it; the PSK selector must not replace that authentication path.
+func TestMultiPSKReplayAndTampering(t *testing.T) {
+	h := echoPSKHandler{users: make(chan int, 4)}
+	opts := pskOptions("none")
+	s, _ := newPSKService(opts, h)
+	recording := &capturePSKConn{}
+	client, _ := snellv4.NewClient(snellv4.ClientOptions{PSK: []byte(opts.Users[0].PSK)})
+	_, err := client.DialConn(recording, M.ParseSocksaddr("example.com:80"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	request := append([]byte(nil), recording.Bytes()...)
+	serve := func(data []byte) error {
+		server, peer := net.Pipe()
+		defer server.Close()
+		defer peer.Close()
+		_ = server.SetDeadline(time.Now().Add(time.Second))
+		go func() { _, _ = peer.Write(data); peer.Close() }()
+		return s.NewConnection(context.Background(), server, M.Socksaddr{}, nil)
+	}
+	tampered := append([]byte(nil), request...)
+	tampered[len(tampered)-1] ^= 1
+	if err := serve(tampered); err == nil {
+		t.Fatal("tampered payload accepted")
+	}
+	// Tampered authenticated headers consume the salt in the upstream cache,
+	// so use a fresh service for the valid/replay pair.
+	s, _ = newPSKService(opts, h)
+	_ = serve(request)
+	select {
+	case user := <-h.users:
+		if user != 0 {
+			t.Fatal(user)
+		}
+	default:
+		t.Fatal("valid request rejected")
+	}
+	if err := serve(request); err == nil || !strings.Contains(err.Error(), "duplicated salt") {
+		t.Fatalf("replay not rejected: %v", err)
+	}
+}
+
+type capturePSKConn struct {
+	net.Conn
+	bytes.Buffer
+}
+
+func (c *capturePSKConn) Write(p []byte) (int, error) { return c.Buffer.Write(p) }
+func (c *capturePSKConn) Read(p []byte) (int, error)  { return c.Buffer.Read(p) }
