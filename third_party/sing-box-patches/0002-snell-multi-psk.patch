+package snell
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"time"
+
+	"github.com/sagernet/sing-box/option"
+	P "github.com/sagernet/sing-snell"
+	"github.com/sagernet/sing-snell/snellv5"
+	"github.com/sagernet/sing/common/auth"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// Remnawave extension: select a standard Snell v4/v5 PSK using the first
+// authenticated record header. Framing, payload authentication and replay
+// protection remain owned by the upstream service, one instance per user.
+// This intentionally does not implement the Surge v5 QUIC proxy extension.
+const maxPSKUsers = 256
+
+type pskService struct {
+	keys       [][]byte
+	services   []*snellv5.Service
+	obfs       P.ObfsConfig
+	handshakes chan struct{}
+}
+
+func newPSKService(options option.SnellInboundOptions, handler P.Handler) (*pskService, error) {
+	if options.PSK != "" || len(options.Users) > maxPSKUsers {
+		return nil, fmt.Errorf("snell: multi_user_psk requires no shared PSK and at most %d users", maxPSKUsers)
+	}
+	mode, err := P.ParseObfsMode(options.ObfsOptions.ObfsMode)
+	if err != nil {
+		return nil, err
+	}
+	if mode != P.ObfsModeNone && mode != P.ObfsModeHTTP {
+		return nil, fmt.Errorf("snell: multi_user_psk supports only none/http obfuscation")
+	}
+	s := &pskService{obfs: P.ObfsConfig{Mode: mode}, handshakes: make(chan struct{}, 8)}
+	keys, names := map[string]bool{}, map[string]bool{}
+	for index, user := range options.Users {
+		if len(user.PSK) < 16 || len(user.PSK) > 255 || user.UserKey != "" || user.Name == "" || keys[user.PSK] || names[user.Name] {
+			return nil, fmt.Errorf("snell: invalid or duplicate PSK user at index %d", index)
+		}
+		keys[user.PSK], names[user.Name] = true, true
+		service, err := snellv5.NewService(snellv5.ServiceOptions{
+			PSK: []byte(user.PSK), Handler: pskHandler{handler},
+		})
+		if err != nil {
+			return nil, err
+		}
+		s.keys = append(s.keys, []byte(user.PSK))
+		s.services = append(s.services, service)
+	}
+	// Empty users deliberately means reject all, never shared-PSK fallback.
+	return s, nil
+}
+
+func (s *pskService) NewConnection(ctx context.Context, conn net.Conn, source M.Socksaddr, onClose N.CloseHandlerFunc) error {
+	if len(s.keys) == 0 {
+		return fmt.Errorf("snell: no authorized users")
+	}
+	select {
+	case s.handshakes <- struct{}{}:
+	default:
+		return fmt.Errorf("snell: handshake capacity exceeded")
+	}
+	held := true
+	defer func() {
+		if held {
+			<-s.handshakes
+		}
+	}()
+	if err := conn.SetReadDeadline(time.Now().Add(10 * time.Second)); err != nil {
+		return err
+	}
+	conn = s.obfs.ServerConn(conn)
+	prefix := make([]byte, P.SaltLen+P.HeaderCipherLen)
+	if _, err := io.ReadFull(conn, prefix); err != nil {
+		return err
+	}
+	for index, psk := range s.keys {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		aead, err := P.NewAEAD(P.DeriveKey(psk, prefix[:P.SaltLen]))
+		if err != nil {
+			return err
+		}
+		header, err := aead.Open(nil, make([]byte, P.NonceLen), prefix[P.SaltLen:], nil)
+		if err != nil {
+			continue
+		}
+		if len(header) != P.HeaderPlainLen || header[0] != P.HeaderVersion {
+			return fmt.Errorf("snell: invalid record header")
+		}
+		cached := &pskPrefixConn{Conn: conn, reader: io.MultiReader(bytes.NewReader(prefix), conn)}
+		// Only unauthenticated key selection consumes a slot. Upstream reusable
+		// sessions can remain alive for hours and must not monopolize this limit.
+		<-s.handshakes
+		held = false
+		return s.services[index].NewConnection(auth.ContextWithUser(ctx, index), cached, source, onClose)
+	}
+	return fmt.Errorf("snell: authentication failed")
+}
+
+type pskPrefixConn struct {
+	net.Conn
+	reader io.Reader
+}
+
+func (c *pskPrefixConn) Read(p []byte) (int, error) { return c.reader.Read(p) }
+
+type pskHandler struct{ P.Handler }
+
+func (h pskHandler) NewConnectionEx(ctx context.Context, conn net.Conn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	_ = conn.SetReadDeadline(time.Time{})
+	h.Handler.NewConnectionEx(ctx, conn, source, destination, onClose)
+}
+
+func (h pskHandler) NewPacketConnectionEx(ctx context.Context, conn N.PacketConn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	_ = conn.SetReadDeadline(time.Time{})
+	h.Handler.NewPacketConnectionEx(ctx, conn, source, destination, onClose)
+}
