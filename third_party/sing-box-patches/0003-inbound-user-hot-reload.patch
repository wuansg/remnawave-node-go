+
+func updateInboundUsers(server *Server) func(w http.ResponseWriter, r *http.Request) {
+	return func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			render.Status(r, http.StatusBadRequest)
+			render.JSON(w, r, newError(err.Error()))
+			return
+		}
+		var req updateInboundUsersRequest
+		if err := json.UnmarshalContext(server.ctx, body, &req); err != nil {
+			render.Status(r, http.StatusBadRequest)
+			render.JSON(w, r, newError(err.Error()))
+			return
+		}
+		inboundManager := service.FromContext[adapter.InboundManager](server.ctx)
+		if inboundManager == nil {
+			render.Status(r, http.StatusServiceUnavailable)
+			render.JSON(w, r, newError("missing inbound manager"))
+			return
+		}
+		type targetInbound struct {
+			tag     string
+			updater adapter.InboundUserUpdater
+			options any
+		}
+		targets := make([]targetInbound, 0, len(req.Inbounds))
+		for index, inb := range req.Inbounds {
+			tag := inb.Tag
+			if tag == "" {
+				tag = F.ToString(index)
+			}
+			runningInbound, loaded := inboundManager.Get(tag)
+			if !loaded || runningInbound.Type() != inb.Type {
+				render.Status(r, http.StatusBadRequest)
+				render.JSON(w, r, newError("inbound not found or type mismatch: "+tag))
+				return
+			}
+			updater, ok := runningInbound.(adapter.InboundUserUpdater)
+			if !ok {
+				render.Status(r, http.StatusBadRequest)
+				render.JSON(w, r, newError("inbound does not support user hot-reload: "+tag))
+				return
+			}
+			targets = append(targets, targetInbound{
+				tag:     tag,
+				updater: updater,
+				options: inb.Options,
+			})
+		}
+		if req.StatsUsers != nil {
+			if v2rayServer := service.FromContext[adapter.V2RayServer](server.ctx); v2rayServer != nil {
+				if statsUpdater, ok := v2rayServer.StatsService().(adapter.StatsUserUpdater); ok {
+					statsUpdater.UpdateUsers(req.StatsUsers)
+				}
+			}
+		}
+		allowedByInbound := make(map[string]map[string]bool, len(targets))
+		for _, target := range targets {
+			if err := target.updater.UpdateInboundUsers(target.options); err != nil {
+				render.Status(r, http.StatusBadRequest)
+				render.JSON(w, r, newError(err.Error()))
+				return
+			}
+			allowedByInbound[target.tag] = extractInboundUserNames(target.options)
+		}
+		closedConnections := 0
+		if server.trafficManager != nil {
+			for _, meta := range server.trafficManager.Connections() {
+				if meta.Metadata.User == "" {
+					continue
+				}
+				allowed, updated := allowedByInbound[meta.Metadata.Inbound]
+				if !updated || allowed[meta.Metadata.User] {
+					continue
+				}
+				if tracker := server.trafficManager.Connection(meta.ID); tracker != nil {
+					tracker.Close()
+					closedConnections++
+				}
+			}
+		}
+		render.JSON(w, r, render.M{
+			"status":            "ok",
+			"closedConnections": closedConnections,
+		})
+	}
+}
+
+func extractInboundUserNames(rawOptions any) map[string]bool {
+	names := make(map[string]bool)
+	addName := func(name string) {
+		if name != "" {
+			names[name] = true
+		}
+	}
+	switch opts := rawOptions.(type) {
+	case *option.VLESSInboundOptions:
+		for _, u := range opts.Users {
+			addName(u.Name)
+		}
+	case *option.VMessInboundOptions:
+		for _, u := range opts.Users {
+			addName(u.Name)
+		}
+	case *option.TrojanInboundOptions:
+		for _, u := range opts.Users {
+			addName(u.Name)
+		}
+	case *option.AnyTLSInboundOptions:
+		for _, u := range opts.Users {
+			addName(u.Name)
+		}
+	case *option.ShadowTLSInboundOptions:
+		for _, u := range opts.Users {
+			addName(u.Name)
+		}
+	case *option.SnellInboundOptions:
+		for _, u := range opts.Users {
+			addName(u.Name)
+		}
+	case *option.ShadowsocksInboundOptions:
+		for _, u := range opts.Users {
+			addName(u.Name)
+		}
+	case *option.Hysteria2InboundOptions:
+		for _, u := range opts.Users {
+			addName(u.Name)
+		}
+	case *option.TUICInboundOptions:
+		for _, u := range opts.Users {
+			addName(u.Name)
+		}
+	}
+	return names
+}
