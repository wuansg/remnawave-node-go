+func (h *Inbound) applyUsers(users []option.Hysteria2User) {
+	h.userAccess.Lock()
+	if h.userNameIndex == nil {
+		h.userNameIndex = make(map[string]int, len(users))
+	}
+	userList := make([]int, 0, len(users))
+	userPasswordList := make([]string, 0, len(users))
+	allowedIDs := make(map[int]bool, len(users))
+	for _, user := range users {
+		var userID int
+		if user.Name != "" {
+			if existing, loaded := h.userNameIndex[user.Name]; loaded {
+				userID = existing
+			} else {
+				userID = len(h.userNameList)
+				h.userNameList = append(h.userNameList, user.Name)
+				h.userNameIndex[user.Name] = userID
+			}
+		} else {
+			userID = len(h.userNameList)
+			h.userNameList = append(h.userNameList, "")
+		}
+		userList = append(userList, userID)
+		userPasswordList = append(userPasswordList, user.Password)
+		allowedIDs[userID] = true
+	}
+	h.allowedIDs = allowedIDs
+	h.service.UpdateUsers(userList, userPasswordList)
+	h.userAccess.Unlock()
